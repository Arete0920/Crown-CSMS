{
  "name": "crown-dashboards",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test tests/proof-smoke.spec.ts --reporter=line",
    "test:e2e:magus": "playwright test tests/magus-verification-smoke.spec.ts --reporter=line",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "api:proof:gradebook": "playwright test tests/api/gradebook-api-proof.spec.ts --reporter=line",
    "ui:proof:gradebook": "playwright test tests/ui/gradebook-ui-proof.spec.ts --reporter=line",
    "ui:proof:nav": "playwright test tests/ui/nav-role-routing.spec.ts --reporter=line",
    "ui:proof:matrix": "playwright test tests/ui/role-dashboard-matrix.spec.ts --reporter=line",
    "ui:proof:matrix-pack-2": "playwright test tests/ui/role-dashboard-matrix-pack-2.spec.ts --reporter=line",
    "ui:proof:matrix-pack-3": "playwright test tests/ui/role-dashboard-matrix-pack-3.spec.ts --reporter=line",
    "ui:proof:nav-perms": "npx playwright test tests/ui/nav-permissions.spec.ts --reporter=line",
    "ui:proof:student-v2": "npx playwright test tests/ui/student-dashboard-v2.spec.ts --reporter=line",
    "ui:proof:parent-v1": "npx playwright test tests/ui/parent-dashboard-v1.spec.ts --reporter=line",
    "ui:proof:executive": "npx playwright test tests/ui/executive-dashboard-v1.spec.ts --reporter=line"
  },
  "dependencies": {
    "@azure/msal-browser": "^3.28.1",
    "@azure/msal-react": "^2.1.1",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^7.3.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "recharts": "^3.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.58.2",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.39.2",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.0",
    "globals": "^17.3.0",
    "vite": "^5.4.11",
    "vitest": "^4.0.18"
  }
}
