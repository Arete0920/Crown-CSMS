{
  "name": "crown-dashboards",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/write-build-json.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:unit": "vitest run src",
    "test:contracts": "vitest run src/tests/writeFlowContract.test.jsx src/tests/permissionContract.test.js src/tests/routeContract.test.jsx src/tests/sidebarContract.test.jsx src/tests/roleGuard.test.jsx src/tests/dashboardCardContract.test.jsx src/tests/apiContractRegistry.test.js src/tests/navigationSurfaceContract.test.js src/tests/parentStatusCenterScaffold.test.jsx",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check:visual-system": "node scripts/check-visual-system.mjs",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test tests/proof-smoke.spec.ts --reporter=line",
    "test:e2e:magus": "playwright test tests/magus-verification-smoke.spec.ts --reporter=line",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "api:proof:gradebook": "playwright test tests/api/gradebook-api-proof.spec.ts --reporter=line",
    "ui:proof:gradebook": "playwright test tests/ui/gradebook-ui-proof.spec.ts --reporter=line",
    "ui:proof:nav": "playwright test tests/ui/nav-role-routing.spec.ts --reporter=line",
    "ui:proof:matrix": "playwright test tests/ui/role-dashboard-matrix.spec.ts --reporter=line",
    "ui:proof:matrix-pack-2": "playwright test tests/ui/role-dashboard-matrix-pack-2.spec.ts --reporter=line",
    "ui:proof:matrix-pack-3": "playwright test tests/ui/role-dashboard-matrix-pack-3.spec.ts --reporter=line",
    "ui:proof:sandbox": "playwright test -c playwright.sandbox.config.js tests/ui/sandbox-20-schools-proof.spec.ts --reporter=line",
    "ui:proof:nav-perms": "npx playwright test tests/ui/nav-permissions.spec.ts --reporter=line",
    "ui:proof:student-v2": "npx playwright test tests/ui/student-dashboard-v2.spec.ts --reporter=line",
    "ui:proof:parent-v1": "npx playwright test tests/ui/parent-dashboard-v1.spec.ts --reporter=line",
    "ui:proof:executive": "npx playwright test tests/ui/executive-dashboard-v1.spec.ts --reporter=line",
    "check:module-readiness": "vitest run src/config/moduleReadiness.test.js",
    "check:shell-contracts": "vitest run src/auth/roleAccess.test.js src/config/dashboardRegistry.test.js src/routes/wizardRouteAccess.test.jsx src/config/shellOwnership.test.js src/config/shellCertification.test.js src/config/moduleReadiness.test.js",
    "check:shell-certification": "npm run check:shell-contracts && npm run check:module-readiness",
    "ci:shell": "npm run check:shell-certification && npm run build",
    "build:shell-backend-contract": "node scripts/build-shell-backend-contract.mjs",
    "check:shell-backend-contract-parity": "node scripts/check-shell-backend-contract-parity.mjs",
    "print:shell-backend-contract": "node scripts/print-shell-backend-contract.mjs",
    "check:shell-backend-contract": "node scripts/check-shell-backend-contract-parity.mjs",
    "debug:shell-backend-contract": "node scripts/print-shell-backend-contract.mjs",
    "ci:shell-backend-contract-parity": "npm run check-shell-backend-contract-parity",
    "verify:dashboard-completeness": "node scripts/verify-dashboard-completeness.mjs",
    "verify:full": "node scripts/run-full-verification.mjs",
    "release:verify": "node ../../scripts/release/verify-frontend-rc.mjs",
    "verify:api-contracts": "node ../../scripts/release/verify-api-contracts.mjs",
    "verify:navigation": "node ../../scripts/release/verify-navigation-surface.mjs",
    "release:demo-proof": "node ../../scripts/release/generate-demo-proof.mjs",
    "test:release:routes": "playwright test tests/release-auth-golden-path.spec.ts",
    "test:release:a11y": "playwright test tests/release-accessibility.spec.ts",
    "certify:scaffold-crawler": "playwright test tests/certification/scaffold-certification-crawler.spec.ts --workers=1 --reporter=line",
    "certify:production-preflight": "playwright test tests/certification/production-runtime-preflight.spec.ts --workers=1 --reporter=line",
    "certify:production-crawler": "npm run certify:production-preflight && playwright test tests/certification/production-certification-crawler.spec.ts --workers=1 --reporter=line",
    "certify:buyer-sandbox-browser": "node scripts/run-buyer-sandbox-browser-authority.mjs",
    "certify:scaffold": "npm run build && npm run certify:scaffold-crawler",
    "certify:production": "npm run certify:production-crawler"
  },
  "dependencies": {
    "@azure/msal-browser": "5.17.1",
    "@azure/msal-react": "5.5.3",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^7.3.8",
    "axios": "^1.16.0",
    "prop-types": "^15.8.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-router": "8.3.0",
    "recharts": "^3.7.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.58.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^25.6.0",
    "@vitejs/plugin-react": "6.0.2",
    "esbuild": "0.28.1",
    "eslint": "10.7.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.0",
    "globals": "^17.3.0",
    "jsdom": "^28.1.0",
    "vite": "8.0.16",
    "vitest": "^4.1.8",
    "yaml": "^2.8.3",
    "eslint-plugin-jsx-a11y-x": "0.2.0"
  },
  "overrides": {
    "postcss": "8.5.23",
    "brace-expansion": "5.0.9",
    "nanoid": "3.3.18"
  },
  "engines": {
    "node": ">=22.22.0"
  }
}
