{
  "routes": [
    {
      "route": "/build.json",
      "headers": {
        "Cache-Control": "no-store, no-cache, must-revalidate, max-age=0"
      }
    },
    {
      "route": "/login",
      "rewrite": "/index.html"
    },
    {
      "route": "/sandbox",
      "rewrite": "/index.html"
    },
    {
      "route": "/sandbox/*",
      "rewrite": "/index.html"
    },
    {
      "route": "/school-admin-dashboard",
      "rewrite": "/index.html"
    },
    {
      "route": "/teacher",
      "rewrite": "/index.html"
    },
    {
      "route": "/parent",
      "rewrite": "/index.html"
    },
    {
      "route": "/student",
      "rewrite": "/index.html"
    }
  ],
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "SAMEORIGIN",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "Content-Security-Policy": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://crown-api-prod.azurewebsites.net https://crown-api-dev.azurewebsites.net; manifest-src 'self'; worker-src 'self' blob:",
    "Permissions-Policy": "camera=(), microphone=(), geolocation=(), payment=(), usb=()",
    "Cross-Origin-Opener-Policy": "same-origin"
  },
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/assets/*",
      "/build.json",
      "/demo/*",
      "/favicon.ico",
      "/robots.txt",
      "/manifest.webmanifest",
      "/*.ico",
      "/*.png",
      "/*.svg",
      "/*.jpg",
      "/*.jpeg",
      "/*.webp"
    ]
  },
  "mimeTypes": {
    ".json": "application/json"
  }
}
