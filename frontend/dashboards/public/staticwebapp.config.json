{
  "routes": [
    {
      "route": "/build.json",
      "headers": {
        "Cache-Control": "no-store, no-cache, must-revalidate, max-age=0"
      }
    },
    {
      "route": "/login",
      "rewrite": "/index.html"
    },
    {
      "route": "/sandbox",
      "rewrite": "/index.html"
    },
    {
      "route": "/sandbox/*",
      "rewrite": "/index.html"
    },
    {
      "route": "/school-admin-dashboard",
      "rewrite": "/index.html"
    },
    {
      "route": "/teacher",
      "rewrite": "/index.html"
    },
    {
      "route": "/parent",
      "rewrite": "/index.html"
    },
    {
      "route": "/student",
      "rewrite": "/index.html"
    }
  ],
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "SAMEORIGIN",
    "Referrer-Policy": "strict-origin-when-cross-origin"
  },
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/assets/*",
      "/build.json",
      "/demo/*",
      "/favicon.ico",
      "/robots.txt",
      "/manifest.webmanifest",
      "/*.ico",
      "/*.png",
      "/*.svg",
      "/*.jpg",
      "/*.jpeg",
      "/*.webp"
    ]
  },
  "mimeTypes": {
    ".json": "application/json"
  }
}
