{
  "responseOverrides": {},
  "routes": [
    {
      "route": "/build.json",
      "headers": {
        "Cache-Control": "no-store, max-age=0"
      }
    }
  ],
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "SAMEORIGIN",
    "Referrer-Policy": "strict-origin-when-cross-origin"
  },
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/assets/*", "/build.json", "/*.json", "/*.ico", "/*.png", "/*.svg"]
  }
}
