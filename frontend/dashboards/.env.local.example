# Local frontend environment variables
# Auto-loaded by Vite during development (dev server restart required)

# Backend API base URL
VITE_API_BASE_URL=

# Heritage sandbox school ID. Sandbox entry uses POST /api/v1/sandbox/session/
# and never requires a buyer username or password.
VITE_DEMO_SCHOOL_ID=

# Optional key for the localhost-only /api/dev/token/ developer utility.
# This is separate from the evaluator-facing Heritage sandbox flow.
VITE_DEMO_KEY=

# Sandbox presentation mode. Do not configure demo usernames, passwords,
# auto-login, or /api/v1/auth/token/ for Heritage sandbox entry.
VITE_DEMO_MODE=
VITE_SANDBOX_MODE=

# ---------------------------------------------------------------------------
# Microsoft Entra ID (MSAL SPA) - set these for Microsoft 365 login
# Leave blank in dev if using the server-side OAuth2 flow (msauth app) instead.
# ---------------------------------------------------------------------------
# VITE_AAD_CLIENT_ID=<spa-app-registration-client-id>
# VITE_AAD_TENANT_ID=<azure-ad-tenant-guid>
# VITE_AAD_REDIRECT_URI=http://localhost:3000/auth/callback
# VITE_AAD_POST_LOGOUT_REDIRECT_URI=http://localhost:3000/
# VITE_AAD_API_SCOPE=api://<api-app-registration-client-id>/access_as_user

# Build SHA - injected by CI pipeline; leave blank locally
# VITE_BUILD_SHA=<git-sha>
