# local.secrets.ps1.example
# Copy this to local.secrets.ps1 (gitignored) and fill in real values
# Usage: . .\local.secrets.ps1

# Azure Postgres
$env:PGHOST = "crown-pg-dev.postgres.database.azure.com"
$env:PGPORT = "5432"
$env:PGDATABASE = "crown2026_dev"
$env:PGUSER = "crownpgadmin"
$env:PGPASSWORD = "<PASTE_FROM_AZURE_PORTAL>"

# Crown API
$env:DATABASE_URL = "postgresql://$env:PGUSER:<PASSWORD>@$env:PGHOST:$env:PGPORT/$env:PGDATABASE?sslmode=require"
$env:DEV_OPS_SECRET = "<PASTE_FROM_AZURE_PORTAL>"
$env:CROWN_OPS_SECRET = "<PASTE_FROM_AZURE_PORTAL>"
$env:CI_SMOKE_PASSWORD = "<PASTE_FROM_AZURE_PORTAL>"

# Derived (computed, never hardcode tokens)
$env:BASE_URL = "https://crown-api-dev.azurewebsites.net"
$env:SCHOOL_ID = "a5351136-98fe-4d48-add0-fa8f62d9ceff"

Write-Host "✓ Secrets loaded from local.secrets.ps1" -ForegroundColor Green
Write-Host "  PGHOST: $env:PGHOST" -ForegroundColor Gray
Write-Host "  BASE_URL: $env:BASE_URL" -ForegroundColor Gray
Write-Host "  All secrets: <REDACTED>" -ForegroundColor Yellow
