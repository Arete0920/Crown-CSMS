# Copy to repo root as .env.release and fill every required value.
# Example:
#   Copy-Item .\audit-artifacts\release-readiness\.env.release.example .\.env.release

# ---------------------------------------------------------------------------
# Base URLs
# ---------------------------------------------------------------------------
CROWN_BASE_URL=https://your-staging-or-prod-url
CROWN_VERIFY_SSL=1
CROWN_EXPECT_ENV=prod

# ---------------------------------------------------------------------------
# Auth paths / keys / token keys
# ---------------------------------------------------------------------------
CROWN_HEALTH_PATH=/api/health/
CROWN_LOGIN_PATH=/api/auth/token/
CROWN_AUTH_EMAIL_KEY=username
CROWN_AUTH_PASSWORD_KEY=password
CROWN_TOKEN_KEYS=access,token,access_token,jwt

# ---------------------------------------------------------------------------
# API surface
# Fill these with representative relative API paths for each area.
# Intentionally blank: do not reuse CROWN_HEALTH_PATH here as a placeholder.
# ---------------------------------------------------------------------------
CROWN_STUDENTS_PATH=
CROWN_ADMISSIONS_PATH=
CROWN_ENROLLMENT_PATH=
CROWN_BILLING_PATH=
CROWN_ATTENDANCE_PATH=
CROWN_PARENT_PORTAL_PATH=
CROWN_TEACHER_GRADEBOOK_PATH=

# ---------------------------------------------------------------------------
# Known-good detail paths for blackbox proof
# Use full relative API paths.
# ---------------------------------------------------------------------------
CROWN_GOLDEN_APPLICATION_DETAIL_PATH=
CROWN_GOLDEN_STUDENT_DETAIL_PATH=
CROWN_GOLDEN_BILLING_DETAIL_PATH=
CROWN_GOLDEN_ATTENDANCE_DETAIL_PATH=

# ---------------------------------------------------------------------------
# Known cross-tenant detail paths: these MUST return 403 or 404
# while authenticated as the wrong school admin.
# ---------------------------------------------------------------------------
CROWN_CROSS_TENANT_STUDENT_DETAIL_PATH=
CROWN_CROSS_TENANT_BILLING_DETAIL_PATH=

# ---------------------------------------------------------------------------
# Credentials
# ---------------------------------------------------------------------------
CROWN_ADMIN_EMAIL=admin@example.invalid
CROWN_ADMIN_PASSWORD=<SET_LOCALLY>
CROWN_PARENT_EMAIL=parent@example.invalid
CROWN_PARENT_PASSWORD=<SET_LOCALLY>
CROWN_TEACHER_EMAIL=teacher@example.invalid
CROWN_TEACHER_PASSWORD=<SET_LOCALLY>

# ---------------------------------------------------------------------------
# Load test tuning
# ---------------------------------------------------------------------------
CROWN_LOCUST_SMOKE_USERS=5
CROWN_LOCUST_SMOKE_SPAWN=1
CROWN_LOCUST_SMOKE_SECONDS=20
CROWN_LOCUST_FINAL_USERS=10
CROWN_LOCUST_FINAL_SPAWN=2
CROWN_LOCUST_FINAL_SECONDS=30